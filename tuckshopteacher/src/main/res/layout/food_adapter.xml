<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/food_listitem_view"
    android:layout_width="match_parent"
    android:layout_height="60dp"
    android:orientation="horizontal"
    android:padding="5dp"
    android:weightSum="10">

    <TextView
        android:id="@+id/flistitem_name"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="2"
        android:gravity="center_vertical"
        android:hint="Food name"
        android:textSize="12sp"
        android:paddingLeft="5dp" />

    <TextView

        android:id="@+id/flistitem_type"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.5"
        android:textSize="12sp"
        android:gravity="center_vertical|center_horizontal"
        android:hint="Soft Drink"/>

    <TextView

        android:id="@+id/flistitem_supplier"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="2.5"
        android:textSize="12sp"
        android:gravity="center_vertical|center_horizontal"
        android:hint="Coca Cola (HK)"/>

    <TextView
        android:id="@+id/flistitem_price"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical|center_horizontal"
        android:hint="$100"
        android:inputType="numberDecimal"
        android:textSize="12sp"/>

    <TextView

        android:id="@+id/flistitem_quantity"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical|center_horizontal"
        android:hint="0"
        android:inputType="number"
        android:textSize="12sp" />

    <ImageButton
        android:id="@+id/flistitem_savechange"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        app:srcCompat="@drawable/ic_baseline_edit_24" />

    <ImageButton
        android:id="@+id/flistitem_delete"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        app:srcCompat="@drawable/ic_baseline_close_24" />

</LinearLayout>